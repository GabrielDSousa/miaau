# Miaau — variáveis de ambiente
#
# Copie para `.env` e preencha. `.env` está no .gitignore e não deve ser
# commitado, enviado por chat, nem colado em issue.
#
#   cp .env.example .env
#   chmod 600 .env
#
# Nenhum valor real mora neste arquivo. O que está entre <> é placeholder.
# O scanner (scripts/scan-secrets.mjs) recusa commit com valor literal aqui.

# ─────────────────────────────────────────────────────────── coletor (local/CI)
# Contato no User-Agent. Obrigatório pelo combinado de coleta do projeto.
MIAU_CONTACT=<seu-email@exemplo.com>

# Base do Nyaa. Só mude se houver espelho oficial.
NYAA_BASE=https://nyaa.si

# Caminho do SQLite local (só para poll/verify/stats na sua máquina).
MIAU_DB=data/miaau.db

# ────────────────────────────────────────────── ponte coletor → Worker → D1
# Base do Worker. `…/ingest` no fim também é aceito.
MIAU_INGEST_URL=https://<seu-worker>.workers.dev

# Segredo compartilhado. O MESMO valor precisa existir como secret no Worker:
#   npx wrangler secret put INGEST_TOKEN
# e como secret do repositório no GitHub (Settings → Secrets → Actions):
#   gh secret set MIAU_INGEST_TOKEN
MIAU_INGEST_TOKEN=<segredo-longo-aleatorio-32-bytes-hex>

# ───────────────────────────────────────────────────── deploy do Worker (CI)
# Token de API da Cloudflare com escopo mínimo: Workers Scripts:Edit e D1:Edit.
# NÃO use o token global da conta. Só é necessário se o deploy for automatizado;
# o fluxo atual publica pelo `npm run deploy` na máquina local.
CLOUDFLARE_API_TOKEN=<token-de-api-com-escopo-minimo>
CLOUDFLARE_ACCOUNT_ID=<id-da-conta>

# ─────────────────────────────────── gatilho opcional: cron do Worker → Actions
# Só necessário se você quiser disparar a coleta de dentro do Worker em vez de
# usar o cron nativo do GitHub Actions (que é o modo atual).
# Fine-grained token, permissão Actions:write apenas neste repositório.
GITHUB_DISPATCH_TOKEN=<github_pat_com_actions_write>
GITHUB_REPO=<usuario>/miaau
